{
  "name": "image-tools",
  "version": "0.1.3-beta.62",
  "description": "Pixores creative desktop suite for video, audio, images, and presentations.",
  "author": "Pixores",
  "private": true,
  "main": "desktop/electron/main.mjs",
  "scripts": {
    "dev": "npm run vision:assets && npm run document:assets && node scripts/generate-background-manifest.mjs && node scripts/generate-video-maker-library-manifest.mjs && next dev",
    "build": "npm run vision:assets && npm run document:assets && node scripts/create-brand-assets.mjs && node scripts/generate-background-manifest.mjs && node scripts/generate-video-maker-library-manifest.mjs && next build",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "npm run build",
    "desktop:package": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --win nsis",
    "start": "next start",
    "lint": "eslint",
    "sync:admin-assets": "node scripts/sync-admin-assets.mjs",
    "generate:video-library": "node scripts/generate-video-maker-library-manifest.mjs",
    "benchmark:phase0": "node scripts/benchmark-pixores-phase0.mjs",
    "brand:build": "node scripts/create-brand-assets.mjs",
    "vision:assets": "node scripts/sync-mediapipe-assets.mjs",
    "document:assets": "node scripts/sync-pdf-worker.mjs",
    "fonts:sync": "node scripts/sync-pixores-fonts.mjs",
    "test:video-parity": "node scripts/test-video-render-parity.mjs",
    "test:frame-render": "node scripts/test-frame-render.mjs",
    "test:social-svg-render": "node scripts/test-social-svg-render.mjs",
    "test:desktop-audio-render": "node scripts/test-desktop-audio-render.mjs",
    "test:smart-clips": "node scripts/test-smart-clips.mjs",
    "test:smart-reframe": "node scripts/test-smart-reframe.mjs",
    "test:audio-ai-path": "node scripts/test-audio-ai-media-resolution.mjs",
    "test:audio-sync": "node scripts/test-audio-sync.mjs",
    "test:audio-effects": "node scripts/test-audio-effects.mjs",
    "test:audio-studio": "node scripts/test-audio-studio.mjs",
    "test:auth-storage": "node scripts/test-auth-storage.mjs",
    "test:auth-recovery": "node scripts/test-auth-recovery.mjs",
    "test:lower-third-colors": "node scripts/test-lower-third-colors.mjs",
    "test:youtube-publisher": "node scripts/test-youtube-publisher.mjs",
    "test:project-export": "node scripts/test-project-export.mjs"
  },
  "build": {
    "appId": "com.pixores.video-maker",
    "productName": "Pixores Video Maker Pro",
    "artifactName": "Pixores.Video.Maker.Pro.Setup.${version}.${ext}",
    "asar": false,
    "compression": "normal",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      ".next/**/*",
      "!.next/cache/**/*",
      "!.next/dev/**/*",
      "app/**/*",
      "components/**/*",
      "desktop/electron/**/*",
      "desktop/assets/**/*",
      "!desktop/assets/*-source.png",
      "lib/**/*",
      "public/**/*",
      "!public/background/**/*",
      "!public/blog/**/*",
      "!public/templates/**/*",
      "!public/uploads/**/*",
      "!release/**/*",
      "!tmp-desktop-render-test/**/*",
      "scripts/generate-background-manifest.mjs",
      "src/**/*",
      "next.config.ts",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/electron/main.mjs"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/assets/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mejiavizcainof-cell",
        "repo": "pixores",
        "channel": "beta",
        "releaseType": "prerelease"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixores Video Maker Pro"
    }
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@remotion/bundler": "^4.0.484",
    "@remotion/captions": "4.0.484",
    "@remotion/install-whisper-cpp": "4.0.484",
    "@remotion/renderer": "^4.0.484",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "5.3.0",
    "heic-convert": "^2.1.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.1",
    "next": "^16.3.1",
    "pdf-lib": "^1.17.1",
    "pdf-poppler": "^0.2.3",
    "pdfjs-dist": "^6.2.108",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-image-crop": "^11.0.10",
    "remotion": "^4.0.484",
    "sharp": "^0.35.3",
    "stripe": "^22.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.0",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
