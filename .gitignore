# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local desktop packages and release artifacts
/release*/
/output/

# local render, smoke-test, and extracted application workspaces
/.tmp-*
/tmp-*/
/.runtime-data/

# generated browser runtime assets and manifests
/public/pdf.worker.min.mjs
/public/video-maker-assets/library.json
/public/video-maker-assets/mediapipe/wasm/

# desktop-only bundled media (kept in local release builds, not web deploys)
/public/video-maker-assets/sound-effects/
/public/video-maker-assets/video-backgrounds/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local admin bulk upload inbox
/admin-bulk-assets/*
!/admin-bulk-assets/.gitkeep
!/admin-bulk-assets/README.md
!/admin-bulk-assets/people/
!/admin-bulk-assets/people/.gitkeep
!/admin-bulk-assets/objects/
!/admin-bulk-assets/objects/.gitkeep
!/admin-bulk-assets/shapes/
!/admin-bulk-assets/shapes/.gitkeep
!/admin-bulk-assets/frames/
!/admin-bulk-assets/frames/.gitkeep
!/admin-bulk-assets/backgrounds/
!/admin-bulk-assets/backgrounds/.gitkeep
